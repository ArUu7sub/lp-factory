{
  "version": 1,
  "sections": [
    {"id": "hero", "purpose": "audience, service promise, primary benefit"},
    {"id": "problems", "purpose": "up to three recognizable customer problems"},
    {"id": "solution", "purpose": "service responsibility and human responsibility"},
    {"id": "use-cases", "purpose": "up to six concrete capabilities or applications"},
    {"id": "process", "purpose": "three to six operating steps"},
    {"id": "final-cta", "purpose": "closing summary and blank LINE placeholder"}
  ],
  "conversion": {"channel": "LINE", "url": ""},
  "header_contract": {
    "mode": "fixed",
    "position": "sticky",
    "shared_component": true,
    "brand": "24H AI",
    "navigation": [
      {"label": "できること", "target": "solution"},
      {"label": "活用例", "target": "use-cases"},
      {"label": "利用の流れ", "target": "process"}
    ]
  },
  "footer_contract": {
    "mode": "shared",
    "brand": "24H AI",
    "navigation": [
      {"label": "できること", "target": "solution"},
      {"label": "活用例", "target": "use-cases"},
      {"label": "利用の流れ", "target": "process"}
    ],
    "back_to_top": false,
    "mobile_layout": "left-aligned-vertical"
  },
  "hero_flow_contract": {
    "item_content": ["number", "label", "action_or_outcome"],
    "desktop_layout": "horizontal-sequence",
    "mobile_layout": "left-aligned-vertical-sequence"
  },
  "hero_copy_contract": {
    "structure": ["eyebrow", "h1", "h2", "cta"],
    "counting_rule": "display_characters_excluding_whitespace_and_line_breaks",
    "eyebrow": {"ideal_min": 10, "ideal_max": 18, "hard_max": 22},
    "h1": {"ideal_min": 18, "ideal_max": 28, "hard_max": 32},
    "h2": {"ideal_min": 20, "ideal_max": 36, "hard_max": 44},
    "long_description_allowed": false,
    "rewrite_policy": "Distill the submitted material into audience, primary benefit, and mechanism. Rewrite naturally; never truncate mechanically. Move supporting detail to later sections."
  },
  "draft_cta_contract": {
    "href": "#",
    "aria_disabled": true,
    "public_status_notice": false
  },
  "visual_contract": {
    "policy_version": 2,
    "hero_layouts": [
      "split-text-left-visual-right",
      "centered-copy-over-background"
    ],
    "hero_art": "built-in imagegen raster asset",
    "mobile": "use responsive crop only when tested safe; otherwise generate a dedicated mobile asset",
    "final_cta": "separate built-in imagegen background asset",
    "copy_rendering": "html",
    "embedded_copy_in_images": false,
    "css_pictorial_hero": false,
    "japanese_line_breaking": "phrase-aware markup verified at 1440px and 390px"
  }
}
