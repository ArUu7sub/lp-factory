{
  "version": 2,
  "sections": [
    {
      "id": "hero",
      "purpose": "audience, service promise, primary benefit"
    },
    {
      "id": "problems",
      "purpose": "up to three recognizable customer problems"
    },
    {
      "id": "solution",
      "purpose": "service responsibility and human responsibility"
    },
    {
      "id": "use-cases",
      "purpose": "up to six concrete capabilities or applications"
    },
    {
      "id": "process",
      "purpose": "three to six operating steps"
    },
    {
      "id": "final-cta",
      "purpose": "closing summary and blank LINE placeholder"
    }
  ],
  "conversion": {
    "channel": "LINE",
    "url": ""
  },
  "header_contract": {
    "mode": "fixed",
    "position": "sticky",
    "shared_component": true,
    "brand": "24H AI",
    "navigation": [
      {
        "label": "できること",
        "target": "solution"
      },
      {
        "label": "活用例",
        "target": "use-cases"
      },
      {
        "label": "利用の流れ",
        "target": "process"
      }
    ]
  },
  "footer_contract": {
    "mode": "shared",
    "brand": "24H AI",
    "navigation": [
      {
        "label": "できること",
        "target": "solution"
      },
      {
        "label": "活用例",
        "target": "use-cases"
      },
      {
        "label": "利用の流れ",
        "target": "process"
      }
    ],
    "back_to_top": false,
    "mobile_layout": "left-aligned-vertical"
  },
  "hero_flow_contract": {
    "item_content": [
      "number",
      "label",
      "action_or_outcome"
    ],
    "semantic_markup": "ordered-list",
    "visual_model": "one-continuous-journey-with-connected-handoffs",
    "desktop_layout": "left-to-right-route",
    "mobile_layout": "left-aligned-top-to-bottom-route",
    "disconnected_equal_cards": false,
    "readability": {
      "action_text_min_px": 18,
      "text_contrast_minimum": "4.5:1",
      "one_character_orphans": false
    },
    "supporting_visual": {
      "when_helpful": "built-in imagegen text-free raster assets",
      "desktop_mobile_assets": "separate when the desktop crop cannot preserve the route and label safe areas",
      "copy_rendering": "html"
    },
    "optional": true,
    "omit_when": "content duplicates solution responsibility split or process participant journey"
  },
  "hero_copy_contract": {
    "structure": [
      "eyebrow",
      "h1",
      "h2",
      "cta"
    ],
    "counting_rule": "display_characters_excluding_whitespace_and_line_breaks",
    "eyebrow": {
      "ideal_min": 10,
      "ideal_max": 18,
      "hard_max": 22
    },
    "h1": {
      "ideal_min": 18,
      "ideal_max": 28,
      "hard_max": 32
    },
    "h2": {
      "ideal_min": 20,
      "ideal_max": 36,
      "hard_max": 44
    },
    "long_description_allowed": false,
    "rewrite_policy": "Distill the submitted material into audience, primary benefit, and mechanism. Rewrite naturally; never truncate mechanically. Move supporting detail to later sections."
  },
  "section_duplication_contract": {
    "scope": "all six fixed sections",
    "exact_copy_reuse": false,
    "semantic_role_overlap": false,
    "copy_audit_artifact": "content/lp-copy.json#section_role_audit",
    "review_evidence_marker": "SECTION_DUPLICATION_AUDIT: PASS",
    "validation_stages": [
      "pre-render",
      "ready-for-preview"
    ]
  },
  "draft_cta_contract": {
    "href": "#",
    "aria_disabled": true,
    "public_status_notice": false
  },
  "visual_contract": {
    "policy_version": 3,
    "hero_layouts": [
      "split-text-left-visual-right",
      "centered-copy-over-background"
    ],
    "hero_art": "built-in imagegen raster asset",
    "mobile": "use responsive crop only when tested safe; otherwise generate a dedicated mobile asset",
    "final_cta": "separate built-in imagegen background asset",
    "copy_rendering": "html",
    "embedded_copy_in_images": false,
    "css_pictorial_hero": false,
    "japanese_line_breaking": "phrase-aware markup verified at 1440px and 390px"
  },
  "standalone_context_contract": {
    "allowed": false,
    "examples": [
      "scope",
      "applicability",
      "reassurance",
      "context"
    ],
    "required_copy_policy": "integrate into the one fixed section that owns the meaning",
    "redundant_copy_policy": "omit",
    "audit_field": "content/lp-copy.json#section_role_audit.standalone_context_blocks",
    "required_audit_value": []
  }
}
